{
    "database": {
        "user": {
            "db_path": "data/db/user.json",
            "db_init": {},
            "defaults": [
            ]
        },
        "session": {
            "db_path": "data/db/session.json",
            "db_init": {}
        },
        "storage": {
            "db_path": "data/db/storage.json",
            "db_init": {
            },
            "defaults": [
                {
                    "filepath": null,
                    "filename": "根目录",
                    "type": null,
                    "remark": "默认目录",
                    "folderID": null,
                    "uploader": null,
                    "size": null
                },
                {
                    "filepath": null,
                    "filename": "音频",
                    "type": null,
                    "remark": "存放音乐文件",
                    "folderID": null,
                    "uploader": null,
                    "size": null
                },
                {
                    "filepath": null,
                    "filename": "视频",
                    "type": null,
                    "remark": "存放视频文件",
                    "folderID": null,
                    "uploader": null,
                    "size": null
                }
            ],
            "extensions": [
                ".pdf",
                ".html",
                ".png",
                ".jpg",
                ".jpeg",
                ".zip",
                ".xlsx",
                ".pdf",
                ".docx",
                ".doc",
                ".md",
                ".json",
                ".msi",
                ".exe",
                ".yaml",
                ".mp3",
                ".lrc",
                ".mp4",
                ".txt"
            ],
            "save_folder": "data/storage",
            "corrections": {
                ".htm": ".html",
                ".markdown": ".md",
                ".yml": ".yaml"
            }
        },
        "cover": {
            "save_folder": "data/static/cover",
            "extensions": [
                ".png",
                ".jpg",
                ".jpeg"
            ]
        },
        "audio": {
            "db_path": "data/db/audio.json",
            "db_init": {},
            "defaults": [
                {
                    "filepath": null,
                    "filename": "音频",
                    "type": null,
                    "remark": "存放音频文件",
                    "folderID": null,
                    "uploader": null,
                    "size": null
                },
                {
                    "filepath": null,
                    "filename": "歌词",
                    "type": null,
                    "remark": "存放歌词文件",
                    "folderID": null,
                    "uploader": null,
                    "size": null
                },
                {
                    "filepath": null,
                    "filename": "封面",
                    "type": null,
                    "remark": "存放封面文件",
                    "folderID": null,
                    "uploader": null,
                    "size": null
                }
            ],
            "default_cover": "data/static/audio/default.png"
        },
        "audio_set": {
            "db_path": "data/db/audio_set.json",
            "db_init": {},
            "defaults": [
                {
                    "setName": "默认合集",
                    "remark": "默认合集",
                    "coverID": null,
                    "audios": [
                    ]
                }
            ]
        }
    },
    "flask": {
        "static_folder": "sources/static",
        "app_init": {
            "import_name": "sixbox",
                "template_folder": "sources/templates",
                "static_folder": "sources/static"
        },
        "env": {
            "api_prefix": "/api/v1",
            "langs": [
                "zh_CN",
                "en"
            ],
            "domain": "messages",
            "locale_dir": "sources/locale",
            "chunk_size": 1024
        },
        "config": {
            "SEND_FILE_MAX_AGE_DEFAULT": 86400
        },
        "sources": {
            "cssmin": {
                "login_css": {
                    "output": "css/generate/login.css",
                    "sources": [
                        "css/component/*",
                        "css/page/login.css",
                        "css/default.css",
                        "css/theme.css"
                    ]
                },
                "storage_css": {
                    "output": "css/generate/storage.css",
                    "sources": [
                        "css/component/*",
                        "css/page/storage.css",
                        "css/default.css",
                        "css/theme.css"
                    ]
                },
                "music_css": {
                    "output": "css/generate/music.css",
                    "sources": [
                        "css/component/*",
                        "css/default.css",
                        "css/theme.css",
                        "css/page/audio.css"
                    ]
                },
                "mine_sweeper_css": {
                    "output": "css/generate/mine_sweeper.css",
                    "sources": [
                        "css/component/*",
                        "css/default.css",
                        "css/theme.css"
                    ]
                }
            },
            "jsmin": {
                "login_js": {
                    "output": "js/generate/login.js",
                    "sources": [
                        "js/spinner/spinner.js",
                        "js/sixbox/helpers/*",
                        "js/sixbox/init/*",
                        "js/sixbox/component/spinner.js",
                        "js/sixbox/component/popup_message.js",
                        "js/sixbox/dataview/*",
                        "js/sixbox/page/login/*"
                    ]
                },
                "storage_js": {
                    "output": "js/generate/storage.js",
                    "sources": [
                        "js/spinner/spinner.js",
                        "js/sixbox/helpers/*",
                        "js/sixbox/init/*",
                        "js/sixbox/component/*",
                        "js/sixbox/dataview/*",
                        "js/sixbox/page/storage/*"
                    ]
                },
                "audio_js": {
                    "output": "js/generate/audio.js",
                    "sources": [
                        "js/spinner/spinner.js",
                        "js/sixbox/helpers/*",
                        "js/sixbox/init/*",
                        "js/sixbox/component/*",
                        "js/sixbox/dataview/*",
                        "js/sixbox/page/audio/*"
                    ]
                },
                "mine_sweeper": {
                    "output": "js/generate/mine_sweeper.js",
                    "sources": [
                        "js/spinner/spinner.js",
                        "js/sixbox/helpers/*",
                        "js/sixbox/init/*",
                        "js/sixbox/component/*",
                        "js/sixbox/dataview/*",
                        "js/sixbox/page/tools/mine_sweeper/*"
                    ]
                }
            }
        }
    }
}